ZOTERO_DATA_DIR=E:/文档/Zotero
ZOTERO_MCP_PORT=8000
ZOTERO_LOCAL=true
ZOTERO_LOCAL_API_BASE=http://host.docker.internal:23119/api
ZOTERO_DB_PATH=/mnt/zotero/zotero.sqlite
ZOTERO_LIBRARY_ID=0
ZOTERO_LIBRARY_TYPE=user
ZOTERO_MCP_TOOLSETS=none,scite,-chatgpt-connector
ZOTERO_MCP_AUTH_ISSUER=https://auth.chen-group.cn
ZOTERO_MCP_RESOURCE_URL=https://zotero-xxx.chen-group.cn
ZOTERO_MCP_JWKS_URI=https://auth.chen-group.cn/jwks.json

# Docker 容器访问 Windows 主机代理的可选覆盖项。
# 未设置时使用 docker-compose.yml 中的默认值：host.docker.internal:7897。
# DOCKER_HTTP_PROXY=http://host.docker.internal:7897
# DOCKER_HTTPS_PROXY=http://host.docker.internal:7897
# DOCKER_NO_PROXY=localhost,127.0.0.1,host.docker.internal

# 仅需要 Zotero Web API 写入或混合模式时填写；本地只读模式可留空。
ZOTERO_API_KEY=
